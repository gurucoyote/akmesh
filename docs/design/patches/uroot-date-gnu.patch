diff --git a/cmds/core/date/date_parse.go b/cmds/core/date/date_parse.go
new file mode 100644
index 0000000..2591fd2
--- /dev/null
+++ b/cmds/core/date/date_parse.go
@@ -0,0 +1,227 @@
+package main
+
+// This file is akmesh's addition to u-root's date: "-d DATE" and "-I", the two
+// forms an agent types when it converts timestamps (docs/abweichungen-gnu.md,
+// acmesh-xli). GNU accepts a whole language of date strings; this covers the
+// shapes that actually appear in scripts and answers every other shape with an
+// error instead of a wrong time.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// parseDateString turns a GNU-style date string into a time. now is the
+// reference for relative forms.
+func parseDateString(s string, now time.Time, loc *time.Location) (time.Time, error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return time.Time{}, fmt.Errorf("no date string given")
+	}
+	// @EPOCH: seconds since 1970, optional fraction
+	if strings.HasPrefix(s, "@") {
+		rest := s[1:]
+		sec, frac, _ := strings.Cut(rest, ".")
+		n, err := strconv.ParseInt(sec, 10, 64)
+		if err != nil {
+			return time.Time{}, fmt.Errorf("invalid date %q", s)
+		}
+		ns := int64(0)
+		if frac != "" {
+			// pad or cut to nanoseconds
+			if len(frac) > 9 {
+				frac = frac[:9]
+			}
+			for len(frac) < 9 {
+				frac += "0"
+			}
+			if v, err := strconv.ParseInt(frac, 10, 64); err == nil {
+				ns = v
+			}
+		}
+		return time.Unix(n, ns).In(loc), nil
+	}
+	switch strings.ToLower(s) {
+	case "now":
+		return now.In(loc), nil
+	case "today":
+		y, m, d := now.In(loc).Date()
+		return time.Date(y, m, d, 0, 0, 0, 0, loc), nil
+	case "yesterday":
+		y, m, d := now.In(loc).Date()
+		return time.Date(y, m, d, 0, 0, 0, 0, loc).AddDate(0, 0, -1), nil
+	case "tomorrow":
+		y, m, d := now.In(loc).Date()
+		return time.Date(y, m, d, 0, 0, 0, 0, loc).AddDate(0, 0, 1), nil
+	}
+	// absolute forms
+	if t, ok := parseAbsolute(s, loc); ok {
+		return t, nil
+	}
+	// weekday words: "monday", "next monday", "last friday"
+	if t, ok := parseWeekday(s, now.In(loc)); ok {
+		return t, nil
+	}
+	// relative forms: "2 days ago", "+3 hours", "-1 week"
+	if t, ok := parseRelative(s, now.In(loc)); ok {
+		return t, nil
+	}
+	return time.Time{}, fmt.Errorf("invalid date %q", s)
+}
+
+// parseAbsolute reads the date shapes that appear in scripts: date only, date
+// and time, with or without seconds, with T or a space, with an explicit zone.
+func parseAbsolute(s string, loc *time.Location) (time.Time, bool) {
+	layouts := []string{
+		"2006-01-02T15:04:05Z07:00",
+		"2006-01-02T15:04:05",
+		"2006-01-02T15:04",
+		"2006-01-02 15:04:05",
+		"2006-01-02 15:04",
+		"2006-01-02",
+		"2006/01/02 15:04:05",
+		"2006/01/02 15:04",
+		"2006/01/02",
+		"02.01.2006 15:04",
+		"02.01.2006",
+	}
+	for _, l := range layouts {
+		var t time.Time
+		var err error
+		if strings.Contains(l, "Z07:00") {
+			t, err = time.Parse(l, s)
+		} else {
+			t, err = time.ParseInLocation(l, s, loc)
+		}
+		if err == nil {
+			return t, true
+		}
+	}
+	return time.Time{}, false
+}
+
+// parseRelative reads "N unit[s] [ago]" and "+N unit[s]" / "-N unit[s]".
+func parseRelative(s string, now time.Time) (time.Time, bool) {
+	// "last week", "next month", "this year": the word stands for one unit.
+	if fields := strings.Fields(strings.ToLower(s)); len(fields) == 2 {
+		if mult, ok := map[string]int{"last": -1, "previous": -1, "next": 1, "this": 0}[fields[0]]; ok {
+			switch strings.TrimSuffix(fields[1], "s") {
+			case "day":
+				return now.AddDate(0, 0, mult), true
+			case "week", "wk":
+				return now.AddDate(0, 0, 7*mult), true
+			case "month":
+				return now.AddDate(0, mult, 0), true
+			case "year":
+				return now.AddDate(mult, 0, 0), true
+			}
+		}
+	}
+	ago := false
+	if strings.HasSuffix(s, " ago") {
+		ago = true
+		s = strings.TrimSuffix(s, " ago")
+	}
+	fields := strings.Fields(s)
+	if len(fields) < 2 {
+		return time.Time{}, false
+	}
+	// "2 days" / "+2 days" / "-1 day"
+	numStr, unit := fields[0], fields[1]
+	sign := 1
+	if strings.HasPrefix(numStr, "+") {
+		numStr = numStr[1:]
+	} else if strings.HasPrefix(numStr, "-") {
+		sign = -1
+		numStr = numStr[1:]
+	}
+	n, err := strconv.Atoi(numStr)
+	if err != nil {
+		return time.Time{}, false
+	}
+	if ago {
+		sign = -sign
+	}
+	n *= sign
+	switch strings.TrimSuffix(strings.ToLower(unit), "s") {
+	case "second", "sec":
+		return now.Add(time.Duration(n) * time.Second), true
+	case "minute", "min":
+		return now.Add(time.Duration(n) * time.Minute), true
+	case "hour", "hr":
+		return now.Add(time.Duration(n) * time.Hour), true
+	case "day":
+		return now.AddDate(0, 0, n), true
+	case "week", "wk":
+		return now.AddDate(0, 0, 7*n), true
+	case "month":
+		return now.AddDate(0, n, 0), true
+	case "year":
+		return now.AddDate(n, 0, 0), true
+	}
+	return time.Time{}, false
+}
+
+// isoFormat maps the -I values onto their format strings, as GNU does.
+func isoFormat(v string) (string, error) {
+	switch v {
+	case "date":
+		return "2006-01-02", nil
+	case "hours":
+		return "2006-01-02T15%z", nil
+	case "minutes":
+		return "2006-01-02T15:04%z", nil
+	case "seconds":
+		return "2006-01-02T15:04:05%z", nil
+	case "ns":
+		return "2006-01-02T15:04:05,000000000%z", nil
+	}
+	return "", fmt.Errorf("unknown --iso-8601 value %q", v)
+}
+
+// parseWeekday reads "monday", "next monday" and "last friday", the shapes an
+// agent writes when it wants a report window. GNU means: "monday" is the coming
+// Monday (today, if it is Monday), "next monday" is the one after today, and
+// "last monday" is the one before.
+func parseWeekday(s string, now time.Time) (time.Time, bool) {
+	names := map[string]time.Weekday{
+		"sunday": time.Sunday, "monday": time.Monday, "tuesday": time.Tuesday,
+		"wednesday": time.Wednesday, "thursday": time.Thursday,
+		"friday": time.Friday, "saturday": time.Saturday,
+	}
+	fields := strings.Fields(strings.ToLower(s))
+	if len(fields) == 0 || len(fields) > 2 {
+		return time.Time{}, false
+	}
+	dir := 1 // forward, "next"
+	day := fields[len(fields)-1]
+	if len(fields) == 2 {
+		switch fields[0] {
+		case "next":
+			dir = 1
+		case "last", "previous":
+			dir = -1
+		default:
+			return time.Time{}, false
+		}
+	}
+	want, ok := names[day]
+	if !ok {
+		return time.Time{}, false
+	}
+	cur := now.Weekday()
+	diff := (int(want) - int(cur) + 7) % 7
+	if dir < 0 {
+		if diff == 0 {
+			diff = 7
+		}
+		return now.AddDate(0, 0, -(7 - diff)), true
+	}
+	if len(fields) == 2 && diff == 0 {
+		// "next monday" on a Monday is a week later
+		diff = 7
+	}
+	return now.AddDate(0, 0, diff), true
+}
