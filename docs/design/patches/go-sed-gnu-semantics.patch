+// longestMatcher gives a pattern POSIX's leftmost-longest choice. Go's engine
+// takes the leftmost start (which POSIX wants too) but then the first
+// alternative that fits, so "a|ab" matches "a" in "ab" while GNU sed matches
+// "ab". CompilePOSIX is no way out: in Go it drops every match that spans a
+// newline, and a sed pattern space is multi-line as soon as N or G was used
+// (measured: "[^<]*" on "a\nb" gives "a\nb" with Compile and nothing with
+// CompilePOSIX, which sent a "N; b loop" program into an endless loop).
+//
+// So the refinement is built from the pattern itself: split a top-level "|"
+// into its alternatives, search each of them anchored at the match start, keep
+// the longest, and take the groups from the whole pattern applied to exactly
+// that slice. A pattern without a top-level "|" cannot differ and is left
+// alone; one with ^ or $ is left alone too, because searching a slice of the
+// text would move those anchors.
+type longestMatcher struct {
+	alts  []*regexp.Regexp // one per alternative, anchored at the text start
+	whole *regexp.Regexp   // the whole pattern, anchored at both ends
+}
+
+func newLongestMatcher(pat string) *longestMatcher {
+	alts := topLevelAlternatives(pat)
+	if len(alts) < 2 || hasLineAnchor(pat) {
+		return nil
+	}
+	m := &longestMatcher{}
+	for _, a := range alts {
+		rx, err := regexp.Compile(`\A(?:` + a + `)`)
+		if err != nil {
+			return nil
+		}
+		m.alts = append(m.alts, rx)
+	}
+	whole, err := regexp.Compile(`\A(?:` + pat + `)\z`)
+	if err != nil {
+		return nil
+	}
+	m.whole = whole
+	return m
