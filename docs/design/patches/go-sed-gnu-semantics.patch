+// matches is FindAllStringSubmatchIndex with the longest alternative at each
+// match start. A nil matcher keeps Go's own choice.
+func (m *longestMatcher) matches(re *regexp.Regexp, src string) [][]int {
+	out := re.FindAllStringSubmatchIndex(src, -1)
+	if m == nil {
+		return out
+	}
+	for _, idx := range out {
+		start, end := idx[0], idx[1]
+		for _, alt := range m.alts {
+			loc := alt.FindStringIndex(src[start:])
+			if loc == nil || start+loc[1] <= end {
+				continue
+			}
+			full := m.whole.FindStringSubmatchIndex(src[start : start+loc[1]])
+			if full == nil {
+				continue
+			}
+			for k, off := range full {
+				if off < 0 {
+					idx[k] = -1
+					continue
+				}
+				idx[k] = start + off
+			}
+			end = start + loc[1]
+		}
+	}
+	return out
