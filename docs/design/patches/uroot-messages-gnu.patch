diff --git a/cmds/core/cat/cat.go b/cmds/core/cat/cat.go
index 81d4331..013c44f 100644
--- a/cmds/core/cat/cat.go
+++ b/cmds/core/cat/cat.go
@@ -18,10 +18,10 @@
 package main
 
 import (
+	"errors"
 	"flag"
 	"fmt"
 	"io"
-	"log"
 	"os"
 )
 
@@ -35,33 +35,66 @@ func cat(reader io.Reader, writer io.Writer) error {
 	return nil
 }
 
+// stderr is where the per-file messages go; main points it at os.Stderr.
+var stderr io.Writer = os.Stderr
+
+// errReported says "a message has been printed already", so main only sets the
+// status and does not print a second line.
+var errReported = errors.New("reported")
+
+// describe renders a failure the way GNU cat does: the file name, then the
+// system's sentence with its capital ("cat: xac: No such file or directory").
+func describe(name string, err error) string {
+	var pe *os.PathError
+	if errors.As(err, &pe) {
+		err = pe.Err
+	}
+	msg := err.Error()
+	if msg != "" && msg[0] >= 'a' && msg[0] <= 'z' {
+		msg = string(msg[0]-32) + msg[1:]
+	}
+	return name + ": " + msg
+}
+
+// run copies every file to the writer, like GNU cat: a file that fails is
+// reported and the next one is still copied; the status is 1 when any failed
+// (acmesh-2rl).
 func run(stdin io.Reader, stdout io.Writer, args ...string) error {
 	if len(args) == 0 {
 		return cat(stdin, stdout)
 	}
+	failed := false
 	for _, file := range args {
 		if file == "-" {
-			err := cat(stdin, stdout)
-			if err != nil {
+			if err := cat(stdin, stdout); err != nil {
 				return err
 			}
 			continue
 		}
 		f, err := os.Open(file)
 		if err != nil {
-			return err
+			fmt.Fprintf(stderr, "cat: %s\n", describe(file, err))
+			failed = true
+			continue
 		}
 		if err := cat(f, stdout); err != nil {
-			return fmt.Errorf("failed to concatenate file %s to given writer", f.Name())
+			fmt.Fprintf(stderr, "cat: %s\n", describe(file, err))
+			failed = true
 		}
 		f.Close()
 	}
+	if failed {
+		return errReported
+	}
 	return nil
 }
 
 func main() {
 	flag.Parse()
 	if err := run(os.Stdin, os.Stdout, flag.Args()...); err != nil {
-		log.Fatalf("cat failed with: %v", err)
+		if !errors.Is(err, errReported) {
+			fmt.Fprintf(os.Stderr, "cat: %v\n", err)
+		}
+		os.Exit(1)
 	}
 }
