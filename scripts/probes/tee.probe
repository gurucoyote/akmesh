# tee gegen GNU coreutils 9.7
rm -f x?? x??? x???? t?.txt s?.txt; printf 'a\nb\n' | tee t1.txt && cat t1.txt
rm -f x?? x??? x???? t?.txt s?.txt; printf 'a\n' | tee t1.txt > /dev/null; printf 'b\n' | tee -a t1.txt; cat t1.txt
rm -f x?? x??? x???? t?.txt s?.txt; printf 'x\n' | tee t1.txt t2.txt > /dev/null; cat t1.txt t2.txt
rm -f x?? x??? x???? t?.txt s?.txt; printf 'x\n' | tee -i t1.txt && cat t1.txt
rm -f x?? x??? x???? t?.txt s?.txt; printf 'x\n' | tee --append t1.txt > /dev/null; cat t1.txt
rm -f x?? x??? x???? t?.txt s?.txt; printf 'zz\n' | tee /dev/null
