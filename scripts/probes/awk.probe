# awk gegen das awk des gepinnten Debian-Images (mawk 1.3.4)
awk '{print}' words.txt
awk '{print $1}' colon.txt
awk -F: '{print $2}' colon.txt
awk -F: '{print $1, $3}' colon.txt
awk '{print NF}' colon.txt
awk '{print NR": "$0}' words.txt
awk 'NR==2' words.txt
awk '/a/' words.txt
awk '!/a/' words.txt
awk '$1=="A"' words.txt
awk 'END{print NR}' words.txt
printf 'p\nq\n' > NumDummy; awk 'BEGIN{print "start"} {print $0} END{print "end"}' NumDummy
awk 'BEGIN{printf "%s=%d\n", "x", 3}'
awk '{print length($0)}' words.txt
awk '{print toupper($0)}' words.txt
awk '{print substr($0, 2, 2)}' colon.txt
awk -v n=2 'NR==n' words.txt
awk '{s+=$1} END{print s}' num.txt
awk 'BEGIN{for(i=1;i<=3;i++) print i}'
awk 'BEGIN{a["x"]=1; a["y"]=2; for(k in a) print k, a[k]}'
awk 'BEGIN{print 7/2, 7%2, 2^10}'
awk 'BEGIN{x="a"; y="b"; print (x<y) ? "kleiner" : "groesser"}'
awk '{print $1 > "/dev/stderr"}' words.txt 2>&1
awk 'BEGIN{while((getline line < "words.txt")>0) n++; print n}'
printf '{ print $2 ":" NR }\n' > prog.awk; awk -f prog.awk colon.txt
awk 'BEGIN{print sprintf("%05.2f", 3.14159)}'
awk 'BEGIN{FS=":"} {print $2}' colon.txt
awk '{print $NF}' colon.txt
awk 'BEGIN{print "\t|" "a" "|"}' | od -c | head -2
awk '{gsub(/a/, "X"); print}' words.txt
awk '{n=gsub(/a/, "X"); print n}' words.txt
awk '{if (match($0, /a+/)) print RSTART, RLENGTH}' words.txt
awk 'BEGIN{n=split("a:b:c", arr, ":"); print n, arr[2]}'
awk 'BEGIN{print index("abcabc", "ca")}'
awk 'BEGIN{print tolower("AbC"), toupper("AbC")}'
awk 'BEGIN{x["a"]=1; delete x["a"]; print length(x)}'
awk '{print FILENAME, FNR, NR}' words.txt colon.txt
awk '{print NR, $0}' words.txt colon.txt | head -4
awk 'BEGIN{OFS="-"}{print $1, $2}' colon.txt
awk 'BEGIN{ORS="|"}{print}' words.txt
awk '{ $2="X"; print }' colon.txt
awk '{ NF=2; print }' colon.txt
awk 'BEGIN{print 1==1.0, "1"==1, "01"==1}'
awk 'BEGIN{print substr("abc", 2), substr("abc", 2, 1), substr("abc", 0, 2)}'
awk 'BEGIN{x=5; print x++, x, ++x}'
awk 'BEGIN{print 10/4, int(10/4), 0.1+0.2}'
awk 'BEGIN{printf "%d|%5.2f|%-4s|%c\n", 42, 3.14159, "ab", 65}'
awk 'BEGIN{print length("äöü"), length(12345)}'
awk 'BEGIN{FS="\t"}{print $2}' tsv.txt
awk -F'\t' '{print NF}' tsv.txt
awk 'BEGIN{while ("echo hi" | getline l) print l}'
awk 'BEGIN{print > "/dev/stderr"}' 2>&1
awk 'BEGIN{x="10"; y=9; if (x > y) print "string"; else print "number"}'
awk 'BEGIN{print -2^2}'
awk 'BEGIN{do {i++} while (i<3); print i}'
awk 'function f(a, b) {return a+b} BEGIN{print f(2,3)}'
awk 'BEGIN{print ENVIRON["HOME"] != ""}'
awk '/a/{next} {print}' words.txt
awk 'BEGIN{print substr("hello", -1)}'
awk 'BEGIN{if (!(1 in a)) print "leer"}'
awk 'BEGIN{print 1e3, 1E3, .5}'
awk 'BEGIN{print "a" "b" 1+1}'
awk 'BEGIN{print length}'
awk 'BEGIN{print substr("abcdef", 2, 3), RSTART}'
awk '{print length}' words.txt
awk 'BEGIN{printf "%x %o %e %g\n", 255, 8, 1234.5, 0.0001}'
awk 'BEGIN{printf "%s", "ohne Umbruch"}'
awk 'BEGIN{x; print length(x), x+0, x ""}'
awk 'BEGIN{print 1/0}'
awk 'BEGIN{print int(-3.7), int("12abc")}'
awk '{ $0 = "neu"; print }' words.txt
awk 'BEGIN{print "x" > "/dev/stdout"}'
awk 'BEGIN{print substr("abc", 2) substr("def", 1, 1)}'
awk 'BEGIN{n=split("", a); print n}'
awk '/a/ && NR>1 {print NR}' words.txt
awk -v OFS=: '{$1=$1; print}' colon.txt
awk 'BEGIN{print 07, 08}'
awk 'BEGIN{print "10"+0, "10" "0", "10"*1}'
awk 'BEGIN{print (1,2) in a}'
awk '{print $1}' empty.txt
awk 'END{print NR, NF}' empty.txt
awk 'BEGIN{print sin(0), cos(0), sqrt(9), log(1), exp(0)}'
awk 'BEGIN{print xor(1,1)}'
awk 'BEGIN{a[1]=1; for (k in a) delete a[k]; print length(a)}'
awk 'BEGIN{print tolower(123)}'
awk 'BEGIN{printf "%5s|%5s|\n", "ab", "abcdef"}'
