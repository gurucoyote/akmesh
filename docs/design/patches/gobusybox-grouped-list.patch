# Replace gobusybox's flat command list with a call to our own printer.
#
# This patch does NOT touch a foreign project's source. makebb generates the
# multicall main.go into .build/gen on every build; this hunk changes that
# generated file, so the text an agent reads is ours (internal/cmdlist) and the
# generator stays as it is. It is applied by scripts/build-bb.sh, which fails the
# build when the hunk no longer applies: a reworded dispatcher upstream must stop
# the build instead of silently shipping the flat list again.
#
# The context is the failure branch of gobusybox v0.6.0 (pkg/bb/bbmain/cmd/main.go).
--- main.go
+++ main.go
@@ -223,10 +223,9 @@
 		log.SetFlags(0)
 		log.Printf("Failed to run command: %v", err)
 
-		log.Printf("Supported commands are:")
-		for _, cmd := range bbmain.ListCmds() {
-			log.Printf(" - %s", cmd)
-		}
+		// The list is akmesh's own (internal/cmdlist, generated into
+		// cmdlist.go beside this file): one line per command, grouped.
+		printSupported()
 		os.Exit(1)
 	} else if err != nil {
 		log.SetFlags(0)
