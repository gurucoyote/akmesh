# akmesh fork of mvdan.cc/sh: $! is the process id of the last background
# command, not a job number ("g1"), so that `cmd & p=$!; kill $p` works - the
# pattern every harness uses to stop what it started (acmesh-tms).
#
# Why a patch and not a copy: AGENTS.md forbids a copy of a foreign project's
# source here. Apply with scripts/apply-sh-fork.sh.
#
# The interpreter starts a background statement in a goroutine, so the pid is
# only known once the exec handler has started the child. The statement is
# carried through the context (bgProcKey) and the handler stores the pid in a
# cell shared by value copies; $! waits for that cell instead of answering a job
# number, which keeps `sleep 30 & echo $!` correct without a sleep in between.
--- a/interp/api.go
+++ b/interp/api.go
@@ -23,6 +23,8 @@
 	"runtime"
 	"slices"
 	"strconv"
+	"sync"
+	"sync/atomic"
 	"time"
 
 	"mvdan.cc/sh/v3/expand"
@@ -255,6 +257,36 @@
 	done chan struct{}
 
 	exit *exitStatus
+
+	// pid is the OS process id of the command this background statement
+	// started, so that $! can be a real pid instead of a job number. It is a
+	// pointer because bgProc values are copied into the runner's slice: the
+	// exec handler and the reader of $! must see the same cell.
+	pid *atomic.Int64
+
+	// pidReady is closed as soon as that pid is known. $!  must not answer
+	// before the process has been started: a shell that reads $!  right after
+	// "cmd &" would otherwise see the job number.
+	pidReady chan struct{}
+	pidOnce  *sync.Once
+}
+
+// bgProcKey carries the background statement through the context, so the exec
+// handler can report the pid it started.
+type bgProcKey struct{}
+
+// setBackgroundPID records the pid of a child started for a background
+// statement. It does nothing when the command was not started in the
+// background.
+func setBackgroundPID(ctx context.Context, pid int) {
+	bg, ok := ctx.Value(bgProcKey{}).(*bgProc)
+	if !ok || pid <= 0 || bg.pid == nil {
+		return
+	}
+	bg.pid.Store(int64(pid))
+	if bg.pidOnce != nil {
+		bg.pidOnce.Do(func() { close(bg.pidReady) })
+	}
 }
 
