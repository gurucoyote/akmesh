+// translatePattern turns the sed spelling of a regexp into Go's. A basic
+// regular expression (the default, no -E) gets its escapes rewritten; an
+// extended one already uses the operators unescaped and is passed through.
+func translatePattern(pattern string, extended bool) (string, error) {
+	translated := pattern
+	if !extended {
+		var err error
+		if translated, err = breToERE(pattern); err != nil {
+			return "", err
+		}
+	}
+	// In sed a "." matches a newline too: the pattern space is multi-line as
+	// soon as N or G was used, and GNU sed still matches across it. Go's
+	// default does not, so the flag goes on every pattern.
+	return "(?s)" + translated, nil
+}
+
+// breToERE rewrites a basic regular expression as GNU sed reads it into the
+// syntax Go's regexp package understands: \( \) \+ \? \| \{ become the
+// operators, the same characters unescaped become literals, \< and \> become
+// word boundaries, \b \w \d keep their Go meaning, and a bracket expression is
+// copied unchanged because nothing inside it is an operator.
+func breToERE(pat string) (string, error) {
+	var b strings.Builder
+	// goGroup[i] is true for a "(" that opened a Go-style group (?...), whose
+	// ")" must stay unescaped. Those are passed through, so a pattern written
+	// for the old engine ((?:...), (?s), (?i)) keeps working.
+	var goGroup []bool
+	inInterval := false
+	for i := 0; i < len(pat); i++ {
+		switch c := pat[i]; c {
+		case '[':
+			// A "]" right after "[" or "[^" is a member, not the end.
+			j := i + 1
+			if j < len(pat) && pat[j] == '^' {
+				j++
+			}
+			if j < len(pat) && pat[j] == ']' {
+				j++
+			}
+			for j < len(pat) && pat[j] != ']' {
+				if pat[j] == '\\' {
+					j++
+				}
+				j++
+			}
+			if j >= len(pat) {
+				return "", fmt.Errorf("unterminated bracket expression %q", pat)
+			}
+			b.WriteString(pat[i : j+1])
+			i = j
+		case '\\':
+			if i+1 >= len(pat) {
+				b.WriteString(`\\`)
+				continue
+			}
+			i++
+			switch d := pat[i]; d {
+			case '(':
+				b.WriteByte('(')
+				goGroup = append(goGroup, false)
+			case ')':
+				b.WriteByte(')')
+				if n := len(goGroup); n > 0 {
+					goGroup = goGroup[:n-1]
+				}
+			case '{':
+				b.WriteByte('{')
+				inInterval = true
+			case '+', '?', '|':
+				b.WriteByte(d)
+			case '}':
+				// Closing brace of "a\{2\}", or a lone "\}" for a literal one.
+				if inInterval {
+					inInterval = false
+					b.WriteByte('}')
+				} else {
+					b.WriteString(`\}`)
+				}
+			case '<', '>':
+				b.WriteString(`\b`)
+			case '1', '2', '3', '4', '5', '6', '7', '8', '9':
+				return "", fmt.Errorf("back reference %q in the search pattern needs a regexp engine with backtracking, the Go engine has none", `\`+string(d))
+			default:
+				b.WriteByte('\\')
+				b.WriteByte(d)
+			}
+		case '(':
+			if i+1 < len(pat) && pat[i+1] == '?' {
+				// A Go-style group: (?:...), (?P<name>...) opens one, (?s)
+				// and its friends are a flag setting that closes at once.
+				if i+2 < len(pat) && pat[i+2] == ':' {
+					b.WriteString("(?:")
+					goGroup = append(goGroup, true)
+					i += 2
+					continue
+				}
+				if end := strings.IndexByte(pat[i:], ')'); end > 0 && pat[i+2] != 'P' {
+					b.WriteString(pat[i : i+end+1])
+					i += end
+					continue
+				}
+				if gt := strings.IndexByte(pat[i:], '>'); gt > 0 {
+					b.WriteString(pat[i : i+gt+1])
+					goGroup = append(goGroup, true)
+					i += gt
+					continue
+				}
+			}
+			b.WriteString(`\(`)
+		case ')':
+			if n := len(goGroup); n > 0 && goGroup[n-1] {
+				goGroup = goGroup[:n-1]
+				b.WriteByte(')')
+				continue
+			}
+			if n := len(goGroup); n > 0 {
+				goGroup = goGroup[:n-1]
+			}
+			b.WriteString(`\)`)
+		case '{', '}':
+			// A literal brace: escaped, because a bare one starts an interval.
+			b.WriteByte('\\')
+			b.WriteByte(c)
+		case '+', '?', '|':
+			b.WriteByte('\\')
+			b.WriteByte(c)
+		default:
+			b.WriteByte(c)
+		}
+	}
+	return b.String(), nil
+}
+
+// topLevelAlternatives splits a pattern at the "|" characters that are not
+// inside a group, a bracket expression or an escape.
+func topLevelAlternatives(pat string) []string {
+	var parts []string
+	depth, start := 0, 0
+	for i := 0; i < len(pat); i++ {
+		switch pat[i] {
+		case '\\':
+			i++
+		case '[':
+			i++
+			if i < len(pat) && pat[i] == '^' {
+				i++
+			}
+			if i < len(pat) && pat[i] == ']' {
+				i++
+			}
+			for i < len(pat) && pat[i] != ']' {
+				if pat[i] == '\\' {
+					i++
+				}
+				i++
+			}
+		case '(':
+			depth++
+		case ')':
+			if depth > 0 {
+				depth--
+			}
+		case '|':
+			if depth == 0 {
+				parts = append(parts, pat[start:i])
+				start = i + 1
+			}
+		}
+	}
+	return append(parts, pat[start:])
+}
+
+// hasLineAnchor reports whether the pattern anchors to the start or the end of
+// the text outside a bracket expression.
+func hasLineAnchor(pat string) bool {
+	for i := 0; i < len(pat); i++ {
+		switch pat[i] {
+		case '\\':
+			i++
+		case '[':
+			i++
+			if i < len(pat) && pat[i] == '^' {
+				i++
+			}
+			if i < len(pat) && pat[i] == ']' {
+				i++
+			}
+			for i < len(pat) && pat[i] != ']' {
+				if pat[i] == '\\' {
+					i++
+				}
+				i++
+			}
+		case '^', '$':
+			return true
+		}
+	}
+	return false
+}
+
+// expandReplacement builds one replacement the way sed writes it: & is the
+// whole match, \1 to \9 are the captured groups, \\ is a backslash, \& a
+// literal ampersand, \n and \t a newline and a tab. $1 and ${name} keep
+// working, because that is how the engine spelled a group before.
+func expandReplacement(re *regexp.Regexp, src, repl string, idx []int) string {
+	group := func(n int) string {
+		if n < 0 || 2*n+1 >= len(idx) || idx[2*n] < 0 {
+			return ""
+		}
+		return src[idx[2*n]:idx[2*n+1]]
+	}
+	var b strings.Builder
+	for i := 0; i < len(repl); i++ {
+		switch c := repl[i]; c {
+		case '\\':
+			if i+1 >= len(repl) {
+				b.WriteByte('\\')
+				continue
+			}
+			i++
+			if repl[i] >= '1' && repl[i] <= '9' {
+				b.WriteString(group(int(repl[i] - '0')))
+				continue
+			}
+			switch repl[i] {
+			case 'n':
+				b.WriteByte('\n')
+			case 't':
+				b.WriteByte('\t')
+			default:
+				b.WriteByte(repl[i])
+			}
+		case '&':
+			b.WriteString(group(0))
+		case '$':
+			if i+1 < len(repl) && repl[i+1] == '$' {
+				b.WriteByte('$')
+				i++
+				continue
+			}
+			if i+1 < len(repl) && repl[i+1] == '{' {
+				if end := strings.IndexByte(repl[i+2:], '}'); end >= 0 {
+					name := repl[i+2 : i+2+end]
+					if n, err := strconv.Atoi(name); err == nil {
+						b.WriteString(group(n))
+					} else {
+						b.WriteString(group(re.SubexpIndex(name)))
+					}
+					i += 2 + end
+					continue
+				}
+			}
+			if i+1 < len(repl) && repl[i+1] >= '0' && repl[i+1] <= '9' {
+				b.WriteString(group(int(repl[i+1] - '0')))
+				i++
+				continue
+			}
+			b.WriteByte('$')
+		default:
+			b.WriteByte(c)
+		}
+	}
+	return b.String()
 }
